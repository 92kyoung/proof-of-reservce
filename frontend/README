# 1. 프론트엔드 의존성
cd frontend
npm install

# 2. .env 설정
cp .env.example .env
# VITE_CONTRACT_ADDRESS=0x... 채우기

# 3. 개발 서버 (백엔드 API 프록시 포함)
npm run dev
# → http://localhost:5173