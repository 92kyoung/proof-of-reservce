# 1. 의존성 설치
npm install

# 2. .env 설정
cp .env.example .env
# BESU_RPC_URL, DEPLOYER_PRIVATE_KEY 등 채우기

# 3. 컴파일 & 배포
npm run compile
npm run deploy

# .env에 CONTRACT_ADDRESS 추가 후

# 4. 오라클 노드 실행 (30초마다 준비금 제출)
npm run oracle

# 5. API 서버 실행 (별도 터미널)
npm run api

# 6. 테스트
npm test